{
  "name": "dpskvn-github-io",
  "version": "1.0.0",
  "private": true,
  "description": "Dino Paškvan's personal site",
  "scripts": {
    "build:blog": "node scripts/build-blog.js",
    "build:css": "tailwindcss -i ./src/style.css -o ./css/style.css --minify",
    "build": "npm-run-all build:blog build:css",
    "watch:css": "tailwindcss -i ./src/style.css -o ./css/style.css --watch",
    "watch:blog": "nodemon --watch posts --ext md --exec \"npm run build:blog\"",
    "serve": "browser-sync start --server --files \"css/**/*.css, **/*.html\" --port 8080",
    "dev": "npm-run-all build --parallel watch:css watch:blog serve"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "browser-sync": "^3.0.3",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.9",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3"
  }
}
